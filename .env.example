NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-public-anon-key

# Server-only email for the single PIN sign-in identity. Do not prefix this
# variable with NEXT_PUBLIC_. The browser submits only the PIN.
ADMIN_LOGIN_EMAIL=your-admin-auth-user@example.com

# Generate a unique server-only value with: openssl rand -hex 32
# Keep the same value across deployments or existing PINs will stop working.
ADMIN_PIN_PEPPER=replace-with-a-random-64-character-hex-value

# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY is also supported for newer projects.

# Never expose service-role or secret credentials through NEXT_PUBLIC_* variables.

# Phase 10: disabled customer worker; credentials are server-only.
NOTIFICATIONS_MODE=disabled
NOTIFICATIONS_EXTERNAL_APPROVED=false
RESEND_API_KEY=
# Future verified bare sender address; configure after domain verification.
RESEND_FROM_EMAIL=
RESEND_SENDER_VERIFIED=false
# Separate local CLI tests only. Never used by the customer/outbox worker.
RESEND_TEST_ENABLED=false
RESEND_TEST_RECIPIENT=delivered@resend.dev

# Owner Telegram delivery runs through the existing ADMIN notification worker.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
KJM_ADMIN_BASE_URL=
# Existing worker infrastructure; keep secrets server-only.
SUPABASE_SERVICE_ROLE_KEY=
NOTIFICATION_CRON_SECRET=
# Enable only after owner configuration and synthetic checks are complete.
NOTIFICATIONS_MODE=disabled
NOTIFICATIONS_EXTERNAL_APPROVED=false

# Set only after verified live QRPh rollout; mirror MAIN's gate for payment controls.
NEXT_PUBLIC_QRPH_LIVE_VERIFIED=false
