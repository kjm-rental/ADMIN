# Server-only. Never use NEXT_PUBLIC for tokens or secrets. Defaults send nothing.
NOTIFICATIONS_MODE=disabled
NOTIFICATIONS_EXTERNAL_APPROVED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_OPERATIONS_CHAT_ID=
TELEGRAM_OPERATIONS_VERIFIED=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_SENDER_VERIFIED=false
SUPABASE_SERVICE_ROLE_KEY=
NOTIFICATION_CRON_SECRET=
# Approved HTTPS origins, no paths, queries, credentials or tokens.
KJM_MAIN_BASE_URL=
KJM_ADMIN_BASE_URL=
# Set only to the actual management-approved pickup location.
KJM_PICKUP_LOCATION=
# Development only: NOTIFICATIONS_MODE=mock. Mock cannot deliver real messages,
# cannot run under NODE_ENV=production, and claims synthetic is_test rows only.
